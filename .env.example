# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=uae_jobs
POSTGRES_USER=jobs_admin
POSTGRES_PASSWORD=  # Must be set - no default for security

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=8501

# CORS Configuration (comma-separated origins, required for production)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# When unset, development defaults are used (localhost:8501, localhost:3000)
# When set, allow_credentials=True; when unset, allow_credentials=False

# Rate Limiting (requires Redis)
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_STATS=10/minute

# Data Ingestion
INGESTION_SCHEDULE=daily
MAX_RETRY_ATTEMPTS=3
REQUEST_TIMEOUT=30

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.85
DEDUP_BATCH_SIZE=1000

# External APIs (if needed)
# LINKEDIN_API_KEY=
# INDEED_API_KEY=
